{
  "name": "tech-growth-hub-mobile",
  "version": "1.2.9",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test --test-concurrency=1 tests/api.test.ts tests/offline.test.ts tests/reader.test.ts tests/ai-export.test.ts tests/formatting.test.ts tests/session.test.ts",
    "export:android": "expo export --platform android --max-workers 1 --output-dir dist/android",
    "export:web": "expo export --platform web --max-workers 1 --output-dir dist/web",
    "build:apk": "npx eas-cli build --platform android --profile preview",
    "test:integration": "tsx --test tests/server.test.ts",
    "test:scripts": "python3 -B -m unittest discover -s tests -p '*_test.py'"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.44",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "markdown-it": "^15.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-markdown-display": {
      "markdown-it": "^15.0.2"
    }
  }
}
