# Existing deployments: keep the original secrets and database credentials.
# This file is a template. The Compose file reads tech-growth-hub.env.
JWT_SECRET=replace-with-existing-jwt-secret-at-least-32-characters
AI_CONFIG_ENCRYPTION_KEY=replace-with-existing-64-hex-character-encryption-key
JWT_EXPIRES_IN=7d
AUTH_COOKIE_SECURE=auto

MYSQL_USER=tech_growth_hub
MYSQL_PASSWORD=replace-with-existing-database-password
MYSQL_ROOT_PASSWORD=replace-with-existing-root-password
MYSQL_DATABASE=tech_growth_hub
# MariaDB accepts MYSQL_* aliases. Avoid conflicting MARIADB_* values.

# Use the browser's actual origin, including the port when it is nonstandard.
ALLOWED_ORIGINS=http://172.18.0.15:8080
AI_ENABLED=true
DEFAULT_AI_PROVIDER=deepseek

INIT_ADMIN_USERNAME=admin
INIT_ADMIN_EMAIL=admin@localhost
INIT_ADMIN_PASSWORD=replace-for-new-installations-only
INIT_ADMIN_FORCE_PASSWORD_CHANGE=true
