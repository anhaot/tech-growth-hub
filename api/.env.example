PORT=3001
NODE_ENV=development
TRUST_PROXY=false

JWT_SECRET=your-super-secret-jwt-key-change-in-production
AI_CONFIG_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32
# 登录有效期：1m 至 365d，或 forever；系统管理中的设置优先
JWT_EXPIRES_IN=7d
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_EMAIL=admin@localhost
INIT_ADMIN_PASSWORD=admin
INIT_ADMIN_FORCE_PASSWORD_CHANGE=true

DATABASE_TYPE=mysql
SQLITE_PATH=./data/tech-growth-hub.db

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=tech_growth_hub
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
MYSQL_DATABASE=tech_growth_hub

AI_ENABLED=true
DEFAULT_AI_PROVIDER=openai

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

ALLOWED_ORIGINS=http://localhost:3000
