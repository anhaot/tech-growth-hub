APP_VERSION=v260805-2

PORT=3001
NODE_ENV=production
TRUST_PROXY=1

JWT_SECRET=your-super-secret-jwt-key-change-in-production
AI_CONFIG_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32
# 登录有效期：1m 至 365d，或 forever；系统管理中的设置优先
JWT_EXPIRES_IN=7d
# auto：HTTPS 请求使用 Secure Cookie，局域网 HTTP 访问不使用；也可显式设置 true/false
AUTH_COOKIE_SECURE=auto
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_EMAIL=admin@localhost
INIT_ADMIN_PASSWORD=admin
INIT_ADMIN_FORCE_PASSWORD_CHANGE=true

DATABASE_TYPE=mysql
SQLITE_PATH=./data/tech-growth-hub.db
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=tech_growth_hub
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
MYSQL_DATABASE=tech_growth_hub

AI_ENABLED=true
DEFAULT_AI_PROVIDER=deepseek

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-pro-4k

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

ALLOWED_ORIGINS=http://localhost:10089,http://127.0.0.1:10089
